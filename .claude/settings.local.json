{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(curl -s http://localhost:5173/)",
      "Bash(curl -s http://localhost:5173/src/main.jsx)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:5173/)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:5174/)",
      "Bash(curl -s http://localhost:5174/src/main.jsx)",
      "PowerShell(Get-NetTCPConnection -State Listen -LocalPort 5173,5174 -ErrorAction SilentlyContinue)",
      "PowerShell(Get-Process node -ErrorAction SilentlyContinue)",
      "PowerShell(\"--- node procs ---\")",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://127.0.0.1:5174/)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" \"http://[::1]:5174/\")"
    ]
  }
}
